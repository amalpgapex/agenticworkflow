# Copy to .env and fill in values. Never commit .env.

WF_ENV=dev

# AWS
AWS_REGION=us-east-1
# Named profile (SSO, etc.). boto3 ignores profiles unless this is set.
# AWS_PROFILE=apg
# Credentials come from the standard boto3 chain (env, profile, or instance role).

# Models (Pydantic AI bedrock: prefix)
WF_EXECUTOR_MODEL=bedrock:us.anthropic.claude-sonnet-4-6
WF_EVALUATOR_MODEL=bedrock:us.anthropic.claude-sonnet-4-6
WF_AGENT_MAX_REQUESTS=20
WF_AGENT_MAX_TOKENS=20000

# Artifacts: "local" writes under ./artifacts ; otherwise an S3 bucket name
WF_ARTIFACT_BUCKET=local

# Email / HITL
WF_SES_SENDER=sender@example.com
WF_REVIEWER_EMAIL=reviewer@example.com
WF_REVIEW_BASE_URL=http://localhost:8000
WF_TOKEN_SECRET=change-me-to-a-long-random-string
WF_PRESIGN_EXPIRY_SECONDS=604800

# Google OAuth (review app). Redirect: http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=wf-task-queue
