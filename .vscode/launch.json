{
    "configurations": [
        {
            "name": "FastAPI (catalyst-nextgen-api)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "cwd": "${workspaceFolder}/src/catalyst-nextgen-api",
            "envFile": "${workspaceFolder}/src/catalyst-nextgen-api/.env",
            "args": [
                "main:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        }
    ]
}