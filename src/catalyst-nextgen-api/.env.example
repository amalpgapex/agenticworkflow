# Azure Cosmos DB Configuration
COSMOS_ENDPOINT=https://your-cosmosdb-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-db-key-here
COSMOS_DATABASE=InKCatalystNextGenDB
COSMOS_CONTAINER=Projects

# Azure Entra ID Configuration
# Get these values from your Azure Entra ID app registration
ENTRA_ID_ENABLED=true
ENTRA_ID_TENANT_ID=your-tenant-id-here
ENTRA_ID_CLIENT_ID=your-client-app-id-here
ENTRA_ID_AUDIENCE=your-client-app-id-here
# Use simple validation for testing (doesn't verify RSA signature)
# Set to false for full RSA signature verification (recommended for production)
ENTRA_ID_SIMPLE_VALIDATION=true

# JWT Configuration (for future use with custom tokens)
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
